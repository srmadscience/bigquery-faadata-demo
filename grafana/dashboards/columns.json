      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT IF(table_type = 'BASE TABLE', 'table', LOWER(table_type)) AS type FROM faa.INFORMATION_SCHEMA.TABLES WHERE table_name = '${table}'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
