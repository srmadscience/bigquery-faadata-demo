        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Rows",
      "description": "Rows in the table; for a view, rows it returns now.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(IF(t.table_type = 'VIEW', NULL, s.row_count), v.row_count) AS row_count\nFROM faa.INFORMATION_SCHEMA.TABLES t\nLEFT JOIN faa.__TABLES__ s ON s.table_id = t.table_name\nLEFT JOIN (SELECT 'aircraft' AS table_name, COUNT(*) AS row_count FROM faa.aircraft\n           UNION ALL SELECT 'airport_aliases', COUNT(*) FROM faa.airport_aliases\n           UNION ALL SELECT 'airport_closed', COUNT(*) FROM faa.airport_closed\n           UNION ALL SELECT 'airport_station', COUNT(*) FROM faa.airport_station) v USING (table_name)\nWHERE t.table_name = '${table}'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 2
