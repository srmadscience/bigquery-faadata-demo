      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT ordinal_position AS `#`, column_name AS `Column`, data_type AS Type, is_nullable AS Nullable,\n  CASE WHEN is_partitioning_column = 'YES' THEN 'partition'\n       WHEN clustering_ordinal_position IS NOT NULL THEN FORMAT('cluster %d', clustering_ordinal_position)\n       ELSE '' END AS `Key`,\n  (SELECT STRING_AGG(o.table_name, ', ' ORDER BY o.table_name) FROM faa.INFORMATION_SCHEMA.COLUMNS o\n   WHERE o.column_name = c.column_name AND o.table_name != c.table_name) AS Also_in\nFROM faa.INFORMATION_SCHEMA.COLUMNS c\nWHERE table_name = '${table}'\nORDER BY ordinal_position"
        }
      ],
      "id": 5,
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Also_in": "Also in"
            }
          }
        }
      ]
