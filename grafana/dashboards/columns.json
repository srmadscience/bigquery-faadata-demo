      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT column_name AS `Column`, COUNT(*) AS `Tables`,\n  STRING_AGG(DISTINCT data_type, ', ') AS Types, STRING_AGG(table_name, ', ' ORDER BY table_name) AS In_tables\nFROM faa.INFORMATION_SCHEMA.COLUMNS\nGROUP BY column_name HAVING COUNT(*) > 1\nORDER BY `Tables` DESC, `Column`"
        }
      ],
