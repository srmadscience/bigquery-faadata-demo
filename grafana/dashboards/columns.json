    {
      "type": "stat",
      "title": "Type",
      "description": "Table or view.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
