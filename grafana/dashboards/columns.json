    {
      "type": "table",
      "title": "Columns of ${table}",
      "description": "In table order. Key: the column the table is partitioned by, or its place in the clustering order. Also in: other tables and views with a column of the same name.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 16
