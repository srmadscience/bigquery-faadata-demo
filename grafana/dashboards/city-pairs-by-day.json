      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT Origin, ANY_VALUE(OriginCityName) AS Origin_city, Dest, ANY_VALUE(DestCityName) AS Dest_city,\n  COUNT(*) AS Days, SUM(count_Flight_Number_Reporting_Airline) AS Flights,\n  SAFE_DIVIDE(SUM(avg_ArrDelay * count_Flight_Number_Reporting_Airline), SUM(IF(avg_ArrDelay IS NULL, 0, count_Flight_Number_Reporting_Airline))) AS Avg_arr,\n  SAFE_DIVIDE(SUM(avg_DepDelay * count_Flight_Number_Reporting_Airline), SUM(IF(avg_DepDelay IS NULL, 0, count_Flight_Number_Reporting_Airline))) AS Avg_dep,\n  SAFE_DIVIDE(SUM(avg_ActualElapsedTime * count_Flight_Number_Reporting_Airline), SUM(IF(avg_ActualElapsedTime IS NULL, 0, count_Flight_Number_Reporting_Airline))) AS Avg_elapsed,\n  ANY_VALUE(avg_Distance) AS Distance\nFROM faa.op_city_pair_by_day\nWHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo())\n  AND Origin IN (${origin:singlequote}) AND Dest IN (${dest:singlequote})\n  AND STRPOS(LOWER(CONCAT(Origin, ' ', OriginCityName, ' ', Dest, ' ', DestCityName)), LOWER(${search:singlequote})) > 0\nGROUP BY Origin, Dest\nORDER BY Flights DESC, Origin, Dest\nLIMIT 5000"
        }
