          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT TIMESTAMP(FlightDate) AS time, COUNT(*) AS `City pairs`, SUM(count_Flight_Number_Reporting_Airline) AS Flights\nFROM faa.op_city_pair_by_day\nWHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo())\n  AND Origin IN (${origin:singlequote}) AND Dest IN (${dest:singlequote})\n  AND STRPOS(LOWER(CONCAT(Origin, ' ', OriginCityName, ' ', Dest, ' ', DestCityName)), LOWER(${search:singlequote})) > 0\nGROUP BY time ORDER BY time"
