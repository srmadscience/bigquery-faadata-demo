          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT FORMAT_DATE('%Y-%m-%d', FlightDate) AS Date, Origin, OriginCityName, Dest, DestCityName,\n  count_Flight_Number_Reporting_Airline AS Flights, avg_ArrDelay, avg_DepDelay, avg_ActualElapsedTime,\n  avg_Distance, min_Distance, max_Distance\nFROM faa.op_city_pair_by_day\nWHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo())\n  AND Origin IN (${origin:singlequote}) AND Dest IN (${dest:singlequote})\n  AND STRPOS(LOWER(CONCAT(Origin, ' ', OriginCityName, ' ', Dest, ' ', DestCityName)), LOWER(${search:singlequote})) > 0\nORDER BY FlightDate, Origin, Dest\nLIMIT 10000"
