    {
      "type": "timeseries",
      "title": "City pairs and flights by day",
      "description": "Matching rows (city pairs) and their flights, per day.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      },
      "gridPos": {
