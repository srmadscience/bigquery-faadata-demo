      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT t.table_name AS `Table`, IF(t.table_type = 'BASE TABLE', 'table', LOWER(t.table_type)) AS Type,\n  COALESCE(IF(t.table_type = 'VIEW', NULL, s.row_count), v.row_count) AS `Rows`,\n  IF(t.table_type = 'VIEW', NULL, s.size_bytes) AS Size, c.columns AS Columns,\n  c.partitioned_by AS Partitioned_by, c.clustered_by AS Clustered_by,\n  TIMESTAMP_MILLIS(s.last_modified_time) AS Last_modified\nFROM faa.INFORMATION_SCHEMA.TABLES t\nLEFT JOIN faa.__TABLES__ s ON s.table_id = t.table_name\nLEFT JOIN (SELECT table_name, COUNT(*) AS columns,\n                  STRING_AGG(IF(is_partitioning_column = 'YES', column_name, NULL)) AS partitioned_by,\n                  STRING_AGG(IF(clustering_ordinal_position IS NOT NULL, column_name, NULL), ', '\n                             ORDER BY clustering_ordinal_position) AS clustered_by\n           FROM faa.INFORMATION_SCHEMA.COLUMNS GROUP BY table_name) c USING (table_name)\nLEFT JOIN (SELECT 'aircraft' AS table_name, COUNT(*) AS row_count FROM faa.aircraft\n           UNION ALL SELECT 'airport_aliases', COUNT(*) FROM faa.airport_aliases\n           UNION ALL SELECT 'airport_closed', COUNT(*) FROM faa.airport_closed\n           UNION ALL SELECT 'airport_station', COUNT(*) FROM faa.airport_station) v USING (table_name)\nORDER BY t.table_type, t.table_name"
        }
      ],
      "id": 5,
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Partitioned_by": "Partitioned by",
              "Clustered_by": "Clustered by",
              "Last_modified": "Last modified"
            }
          }
        }
      ]
    },
