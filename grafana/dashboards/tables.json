      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT w.table_name AS `View`, v.row_count AS `Rows`, w.view_definition AS Definition\nFROM faa.INFORMATION_SCHEMA.VIEWS w\nLEFT JOIN (SELECT 'aircraft' AS table_name, COUNT(*) AS row_count FROM faa.aircraft\n           UNION ALL SELECT 'airport_aliases', COUNT(*) FROM faa.airport_aliases\n           UNION ALL SELECT 'airport_closed', COUNT(*) FROM faa.airport_closed\n           UNION ALL SELECT 'airport_station', COUNT(*) FROM faa.airport_station) v USING (table_name)\nORDER BY 1"
        }
      ],
      "id": 6,
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      }
