    {
      "type": "table",
      "title": "Tables and views",
      "description": "Click a name to see its columns. Size is logical (uncompressed) bytes. A view's rows are counted by running it; one added to the dataset later shows no count until it is added to this dashboard's queries.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
