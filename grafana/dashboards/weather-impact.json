          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT multiIf(o_vsby < 0.5, '< 1/2 mi', o_vsby < 1, '1/2-1 mi', o_vsby < 3, '1-3 mi', o_vsby < 6, '3-5 mi',\n               o_vsby < 10, '6-9 mi', '10+ mi') AS Visibility,\n       round(100 * countIf(DepDel15 = 1) / countIf(Cancelled = 0), 1) AS `% departing 15+ min late`,\n       round(100 * avg(Cancelled), 2) AS `% cancelled`,\n       round(avg(DepDelay), 1) AS `Avg departure delay`,\n       count() AS Flights\nFROM faa.flight_weather WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND o_vsby IS NOT NULL\nGROUP BY Visibility ORDER BY min(o_vsby)"
