          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-faa"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT multiIf(w < 10, '0-9 kt', w < 20, '10-19 kt', w < 30, '20-29 kt', w < 40, '30-39 kt', '40+ kt') AS Wind,\n       round(100 * countIf(DepDel15 = 1) / countIf(Cancelled = 0), 1) AS `% departing 15+ min late`,\n       round(100 * avg(Cancelled), 2) AS `% cancelled`,\n       round(avg(DepDelay), 1) AS `Avg departure delay`,\n       count() AS Flights\nFROM (SELECT *, greatest(ifNull(o_sknt, 0), ifNull(o_gust, 0)) AS w\n      FROM faa.flight_weather WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND o_sknt IS NOT NULL)\nGROUP BY Wind ORDER BY min(w)"
        }
      ],
