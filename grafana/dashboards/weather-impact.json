    {
      "type": "barchart",
      "title": "By flight category at origin",
      "description": "VFR: ceiling above 3,000 ft and visibility over 5 mi. MVFR: 1,000-3,000 ft or 3-5 mi. IFR: 500-999 ft or 1-3 mi. LIFR: below 500 ft or under 1 mi. Measured at the origin's last report before scheduled departure.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT o_category AS Category, ROUND(100 * SAFE_DIVIDE(COUNTIF(DepDel15 = 1), COUNTIF(Cancelled = 0)), 1) AS `% departing 15+ min late`,\n       ROUND(100 * AVG(Cancelled), 2) AS `% cancelled`,\n       ROUND(AVG(DepDelay), 1) AS `Avg departure delay`,\n       COUNT(*) AS Flights\nFROM faa.flight_weather WHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND o_category != ''\nGROUP BY Category ORDER BY CASE Category WHEN 'VFR' THEN 0 WHEN 'MVFR' THEN 1 WHEN 'IFR' THEN 2 WHEN 'LIFR' THEN 3 END"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^% .*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% cancelled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Avg .*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Flights"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": true,
                  "tooltip": false
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "Category",
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8
    },
    {
      "type": "barchart",
      "title": "By present weather at origin",
      "description": "Most significant weather in the origin's report: thunderstorm > freezing precipitation > snow/ice > fog > rain > none.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT o_wx AS Weather, ROUND(100 * SAFE_DIVIDE(COUNTIF(DepDel15 = 1), COUNTIF(Cancelled = 0)), 1) AS `% departing 15+ min late`,\n       ROUND(100 * AVG(Cancelled), 2) AS `% cancelled`,\n       ROUND(AVG(DepDelay), 1) AS `Avg departure delay`,\n       COUNT(*) AS Flights\nFROM faa.flight_weather WHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND o_wx != ''\nGROUP BY Weather ORDER BY CASE Weather WHEN 'None' THEN 0 WHEN 'Rain' THEN 1 WHEN 'Fog' THEN 2 WHEN 'Snow/ice' THEN 3 WHEN 'Freezing' THEN 4 WHEN 'Thunderstorm' THEN 5 END"
        }
      ],
      "fieldConfig": {
