    },
    {
      "type": "barchart",
      "title": "By wind at origin",
      "description": "Sustained wind or gust, whichever is higher, in knots.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN w < 10 THEN '0-9 kt' WHEN w < 20 THEN '10-19 kt' WHEN w < 30 THEN '20-29 kt' WHEN w < 40 THEN '30-39 kt' ELSE '40+ kt' END AS Wind, ROUND(100 * SAFE_DIVIDE(COUNTIF(DepDel15 = 1), COUNTIF(Cancelled = 0)), 1) AS `% departing 15+ min late`,\n       ROUND(100 * AVG(Cancelled), 2) AS `% cancelled`,\n       ROUND(AVG(DepDelay), 1) AS `Avg departure delay`,\n       COUNT(*) AS Flights\nFROM (SELECT *, GREATEST(IFNULL(o_sknt, 0), IFNULL(o_gust, 0)) AS w\n      FROM faa.flight_weather WHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND o_sknt IS NOT NULL)\nGROUP BY Wind ORDER BY MIN(w)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
