      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT 100 * SAFE_DIVIDE(COUNTIF(o_category IN ('IFR', 'LIFR')), COUNTIF(o_category != '')) AS value FROM faa.flight_weather WHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})"
        }
      ],
