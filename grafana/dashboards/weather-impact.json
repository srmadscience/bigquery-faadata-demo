          "format": 1,
          "rawSql": "SELECT multiIf(o_tmpf < 10, '< 10°F', o_tmpf < 20, '10-19°F', o_tmpf < 32, '20-31°F', o_tmpf < 50, '32-49°F',\n               o_tmpf < 70, '50-69°F', o_tmpf < 90, '70-89°F', '90+°F') AS Temperature,\n       round(100 * countIf(DepDel15 = 1) / countIf(Cancelled = 0), 1) AS `% departing 15+ min late`,\n       round(100 * avg(Cancelled), 2) AS `% cancelled`,\n       round(avg(DepDelay), 1) AS `Avg departure delay`,\n       count() AS Flights\nFROM faa.flight_weather WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND o_tmpf IS NOT NULL\nGROUP BY Temperature ORDER BY min(o_tmpf)"
