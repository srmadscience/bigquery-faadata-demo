    {
      "type": "barchart",
      "title": "By visibility at origin",
      "description": "Surface visibility in statute miles.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN o_vsby < 0.5 THEN '< 1/2 mi' WHEN o_vsby < 1 THEN '1/2-1 mi' WHEN o_vsby < 3 THEN '1-3 mi'\n            WHEN o_vsby < 6 THEN '3-5 mi' WHEN o_vsby < 10 THEN '6-9 mi' ELSE '10+ mi' END AS Visibility, ROUND(100 * SAFE_DIVIDE(COUNTIF(DepDel15 = 1), COUNTIF(Cancelled = 0)), 1) AS `% departing 15+ min late`,\n       ROUND(100 * AVG(Cancelled), 2) AS `% cancelled`,\n       ROUND(AVG(DepDelay), 1) AS `Avg departure delay`,\n       COUNT(*) AS Flights\nFROM faa.flight_weather WHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND o_vsby IS NOT NULL\nGROUP BY Visibility ORDER BY MIN(o_vsby)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
