    {
      "type": "barchart",
      "title": "By flight category at origin",
      "description": "VFR: ceiling above 3,000 ft and visibility over 5 mi. MVFR: 1,000-3,000 ft or 3-5 mi. IFR: 500-999 ft or 1-3 mi. LIFR: below 500 ft or under 1 mi. Measured at the origin's last report before scheduled departure.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-faa"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT o_category AS Category, round(100 * countIf(DepDel15 = 1) / countIf(Cancelled = 0), 1) AS `% departing 15+ min late`,\n       round(100 * avg(Cancelled), 2) AS `% cancelled`,\n       round(avg(DepDelay), 1) AS `Avg departure delay`,\n       count() AS Flights\nFROM faa.flight_weather WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND o_category != ''\nGROUP BY Category ORDER BY indexOf(['VFR', 'MVFR', 'IFR', 'LIFR'], Category)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^% .*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% cancelled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Avg .*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Flights"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "viz": true,
                  "legend": true,
                  "tooltip": false
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "Category",
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8
    },
