    {
      "type": "stat",
      "title": "In IFR/LIFR",
      "description": "Share of flights whose origin was below 1,000 ft ceiling or 3 mi visibility at departure time.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
