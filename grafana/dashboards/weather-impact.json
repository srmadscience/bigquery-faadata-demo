    {
      "type": "table",
      "title": "Airport-days with the most cancellations",
      "description": "Airport-days with 50+ scheduled departures, ranked by cancellation rate, with the weather observed at departure times that day. Weather lists the most common significant conditions.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- rank airport-days cheaply first, then summarise the weather for the top 100 only\nWITH top AS (\n    SELECT FlightDate, Origin FROM faa.flight_weather WHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\n    GROUP BY FlightDate, Origin HAVING COUNT(*) >= 50\n    ORDER BY AVG(Cancelled) DESC, COUNT(*) DESC\n    LIMIT 100\n),\ndays AS (\n    SELECT FlightDate, Origin, COUNT(*) AS departures, AVG(Cancelled) AS cancelled, AVG(DepDelay) AS dep_delay,\n           SAFE_DIVIDE(COUNTIF(o_category IN ('IFR', 'LIFR')), COUNTIF(o_category != '')) AS ifr,\n           APPROX_TOP_COUNT(o_wx, 3) AS top_wx, MIN(o_vsby) AS vsby,\n           MAX(GREATEST(IFNULL(o_sknt, 0), IFNULL(o_gust, 0))) AS wind, MIN(o_tmpf) AS tmpf,\n           COUNTIF(Cancelled = 1 AND CancellationCode = 'B') AS weather_cxl\n    FROM faa.flight_weather INNER JOIN top USING (FlightDate, Origin)\n    WHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\n    GROUP BY FlightDate, Origin\n)\nSELECT CAST(FlightDate AS STRING) AS Date, Origin AS Airport,\n       departures AS Departures,\n       ROUND(100 * cancelled, 1) AS `Cancelled %`,\n       ROUND(dep_delay, 0) AS `Avg dep delay`,\n       ROUND(100 * ifr, 0) AS `IFR_LIFR`,\n       ARRAY_TO_STRING(ARRAY(SELECT t.value FROM UNNEST(top_wx) AS t WHERE t.value NOT IN ('None', '')), ', ') AS Weather,\n       ROUND(vsby, 2) AS `Min_vis_mi`,\n       wind AS `Max_wind_kt`,\n       ROUND(tmpf, 0) AS `Min_temp_F`,\n       weather_cxl AS `Weather cxl`\nFROM days\nORDER BY `Cancelled %` DESC, Departures DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
