          "rawQuery": true,
          "rawSql": "SELECT d_category AS Category, ROUND(100 * SAFE_DIVIDE(COUNTIF(ArrDel15 = 1), COUNTIF(Cancelled = 0 AND Diverted = 0)), 1) AS `% arriving 15+ min late`,\n       ROUND(100 * AVG(Diverted), 2) AS `% diverted`,\n       ROUND(100 * AVG(Cancelled), 2) AS `% cancelled`,\n       ROUND(AVG(ArrDelay), 1) AS `Avg arrival delay`,\n       COUNT(*) AS Flights\nFROM faa.flight_weather WHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND d_category != ''\nGROUP BY Category ORDER BY CASE Category WHEN 'VFR' THEN 0 WHEN 'MVFR' THEN 1 WHEN 'IFR' THEN 2 WHEN 'LIFR' THEN 3 END"
