          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN o_tmpf < 10 THEN '< 10°F' WHEN o_tmpf < 20 THEN '10-19°F' WHEN o_tmpf < 32 THEN '20-31°F'\n            WHEN o_tmpf < 50 THEN '32-49°F' WHEN o_tmpf < 70 THEN '50-69°F' WHEN o_tmpf < 90 THEN '70-89°F' ELSE '90+°F' END AS Temperature, ROUND(100 * SAFE_DIVIDE(COUNTIF(DepDel15 = 1), COUNTIF(Cancelled = 0)), 1) AS `% departing 15+ min late`,\n       ROUND(100 * AVG(Cancelled), 2) AS `% cancelled`,\n       ROUND(AVG(DepDelay), 1) AS `Avg departure delay`,\n       COUNT(*) AS Flights\nFROM faa.flight_weather WHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND o_tmpf IS NOT NULL\nGROUP BY Temperature ORDER BY MIN(o_tmpf)"
