    {
      "type": "table",
      "title": "Airport-days with the most cancellations",
      "description": "Airport-days with 50+ scheduled departures, ranked by cancellation rate, with the weather observed at departure times that day. Weather lists the most common significant conditions.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-faa"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toString(FlightDate) AS Date, Origin AS Airport,\n       count() AS Departures,\n       round(100 * avg(Cancelled), 1) AS `Cancelled %`,\n       round(avg(DepDelay), 0) AS `Avg dep delay`,\n       round(100 * countIf(o_category IN ('IFR', 'LIFR')) / countIf(o_category != ''), 0) AS `IFR/LIFR %`,\n       arrayStringConcat(arrayFilter(x -> x NOT IN ('None', ''), topK(3)(o_wx)), ', ') AS Weather,\n       round(min(o_vsby), 2) AS `Min vis (mi)`,\n       max(greatest(ifNull(o_sknt, 0), ifNull(o_gust, 0))) AS `Max wind (kt)`,\n       round(min(o_tmpf), 0) AS `Min temp (°F)`,\n       countIf(Cancelled = 1 AND CancellationCode = 'B') AS `Weather cxl`\nFROM faa.flight_weather WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\n  -- rank airport-days cheaply first, then summarise the weather for the top 100 only\n  AND (FlightDate, Origin) IN (\n    SELECT FlightDate, Origin FROM faa.flight_weather WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\n    GROUP BY FlightDate, Origin HAVING count() >= 50\n    ORDER BY avg(Cancelled) DESC, count() DESC\n    LIMIT 100)\nGROUP BY FlightDate, Origin\nORDER BY `Cancelled %` DESC, Departures DESC"
        }
      ],
