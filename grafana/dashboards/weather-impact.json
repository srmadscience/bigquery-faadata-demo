          "rawQuery": true,
          "rawSql": "SELECT d_wx AS Weather, ROUND(100 * SAFE_DIVIDE(COUNTIF(ArrDel15 = 1), COUNTIF(Cancelled = 0 AND Diverted = 0)), 1) AS `% arriving 15+ min late`,\n       ROUND(100 * AVG(Diverted), 2) AS `% diverted`,\n       ROUND(100 * AVG(Cancelled), 2) AS `% cancelled`,\n       ROUND(AVG(ArrDelay), 1) AS `Avg arrival delay`,\n       COUNT(*) AS Flights\nFROM faa.flight_weather WHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND d_wx != ''\nGROUP BY Weather ORDER BY CASE Weather WHEN 'None' THEN 0 WHEN 'Rain' THEN 1 WHEN 'Fog' THEN 2 WHEN 'Snow/ice' THEN 3 WHEN 'Freezing' THEN 4 WHEN 'Thunderstorm' THEN 5 END"
