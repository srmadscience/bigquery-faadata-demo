          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT a.airport AS airport, ANY_VALUE(a.airport_name) AS name, ANY_VALUE(a.lat) AS lat, ANY_VALUE(a.lon) AS lon,\n       CAST(COUNT(*) AS FLOAT64) AS flights, ROUND(AVG(o.DepDelay), 1) AS avg_dep_delay\nFROM faa.ontime AS o\nINNER JOIN faa.airport_station AS a ON a.airport = o.Origin\nWHERE o.FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND o.Reporting_Airline IN (${airline:singlequote}) AND o.Origin IN (${origin:singlequote})\nGROUP BY airport HAVING flights >= 100"
        }
