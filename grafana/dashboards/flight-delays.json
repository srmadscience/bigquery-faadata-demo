      "options": {
        "xField": "City pair",
        "orientation": "horizontal",
        "showValue": "always",
        "barWidth": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT `City pair`, `Carrier_cxl_1k_flights`, delay,\n       -- as text, so they appear in the tooltip without being drawn as bars\n       -- city names from one flight of the pair, ordered like the airport codes\n       IF(STARTS_WITH(`City pair`, one.Origin), CONCAT(one.o, ' – ', one.d), CONCAT(one.d, ' – ', one.o)) AS Cities,\n       CAST(flights AS STRING) AS Flights, CAST(delay AS STRING) AS `Carrier_delay_min_flt`\nFROM (\n    SELECT CONCAT(LEAST(Origin, Dest), '–', GREATEST(Origin, Dest)) AS `City pair`,\n           ROUND(1000 * COUNTIF(Cancelled = 1 AND CancellationCode = 'A') / COUNT(*), 1) AS `Carrier_cxl_1k_flights`,\n           ROUND(SAFE_DIVIDE(SUM(CarrierDelay), COUNTIF(Cancelled = 0)), 1) AS delay,\n           ANY_VALUE(STRUCT(Origin, OriginCityName AS o, DestCityName AS d)) AS one,\n           COUNT(*) AS flights\n    FROM faa.ontime WHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\n    GROUP BY `City pair` HAVING COUNTIF(Cancelled = 0) >= ${min_flights}\n)\nORDER BY `Carrier_cxl_1k_flights` DESC, delay DESC\nLIMIT 10"
        }
      ],
      "id": 15,
      "transformations": [
