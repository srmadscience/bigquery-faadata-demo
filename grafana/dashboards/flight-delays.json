      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-faa"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "-- Rank first, then find the main route of just the ten flights ranked.\nWITH top AS (\n    SELECT Reporting_Airline AS airline, Flight_Number_Reporting_Airline AS number, count() AS flights,\n           round(1000 * countIf(Cancelled = 1 AND CancellationCode = 'A') / flights, 1) AS cxl,\n           round(sum(CarrierDelay) / countIf(Cancelled = 0), 1) AS carrier_delay\n    FROM faa.ontime WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\n    GROUP BY airline, number HAVING countIf(Cancelled = 0) >= ${min_flights}\n    ORDER BY cxl DESC, carrier_delay DESC\n    LIMIT 10\n)\nSELECT concat(airline, ' ', toString(number), ' (', topK(1)(concat(Origin, '–', Dest))[1], ')') AS Flight,\n       any(cxl) AS `Carrier cxl / 1k flights`, any(carrier_delay) AS delay,\n       -- as text, so they appear in the tooltip without being drawn as bars\n       toString(uniqExact(Origin, Dest)) AS Routes,\n       toString(any(flights)) AS Flights, toString(delay) AS `Carrier delay min/flt`\nFROM faa.ontime INNER JOIN top ON Reporting_Airline = airline AND Flight_Number_Reporting_Airline = number\nWHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\nGROUP BY airline, number\nORDER BY `Carrier cxl / 1k flights` DESC, delay DESC"
        }
      ],
      "id": 16
    }
