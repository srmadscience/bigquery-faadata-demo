          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT a.airport AS airport, any(a.airport_name) AS name, any(a.lat) AS lat, any(a.lon) AS lon,\n       toFloat64(count()) AS flights, round(avg(o.DepDelay), 1) AS avg_dep_delay\nFROM faa.ontime AS o\nINNER JOIN faa.airport_station AS a ON a.airport = o.Origin\nWHERE $__dateFilter(o.FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\nGROUP BY airport HAVING flights >= 100"
