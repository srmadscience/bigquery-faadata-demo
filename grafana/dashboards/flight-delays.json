    {
      "type": "timeseries",
      "title": "Average delay by day",
      "description": "Mean delay in minutes per day (local date of departure). Negative = early.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-faa"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toDateTime(FlightDate) AS time,\n       avg(DepDelay) AS `Departure delay`,\n       avg(ArrDelay) AS `Arrival delay`\nFROM faa.ontime WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\nGROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "m"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Late and cancelled flights by day",
      "description": "Share of each day's scheduled flights.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-faa"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-faa"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toDateTime(FlightDate) AS time,\n       100 * countIf(DepDel15 = 1) / count() AS `Departed 15+ min late`,\n       100 * countIf(ArrDel15 = 1) / count() AS `Arrived 15+ min late`,\n       100 * avg(Cancelled) AS `Cancelled`\nFROM faa.ontime WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\nGROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cancelled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Delay minutes by cause, per month",
      "description": "Total delay minutes attributed to each cause (reported for flights arriving 15+ min late). Note most weather delay is booked under NAS, not 'Extreme weather'.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-faa"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toDateTime(toStartOfMonth(FlightDate)) AS time,\n       sum(CarrierDelay) AS Carrier,\n       sum(LateAircraftDelay) AS `Late aircraft`,\n       sum(NASDelay) AS `Air traffic system (NAS)`,\n       sum(WeatherDelay) AS `Extreme weather`,\n       sum(SecurityDelay) AS Security\nFROM faa.ontime WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\nGROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 0,
            "barAlignment": 1,
            "barWidthFactor": 0.9,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Airlines",
      "description": "Reporting carriers by on-time arrival rate. Codes are BTS carrier codes (AA American, DL Delta, UA United, WN Southwest, B6 JetBlue, AS Alaska, NK Spirit, F9 Frontier, ...).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-faa"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-faa"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT Reporting_Airline AS Airline,\n       count() AS Flights,\n       round(100 * countIf(ArrDel15 = 0) / countIf(Cancelled = 0 AND Diverted = 0), 1) AS `On time %`,\n       round(avg(ArrDelay), 1) AS `Avg arr delay`,\n       round(100 * avg(Cancelled), 2) AS `Cancelled %`\nFROM faa.ontime WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\nGROUP BY Airline ORDER BY `On time %` DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "On time %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-RdYlGr"
                }
              },
              {
                "id": "min",
                "value": 60
              },
              {
                "id": "max",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 10
    },
    {
      "type": "barchart",
      "title": "Departure delay by scheduled hour",
      "description": "By scheduled local departure hour. Delays build up through the day as late aircraft knock on.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-faa"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT lpad(toString(intDiv(CRSDepTime, 100) % 24), 2, '0') AS hour,\n       round(avg(DepDelay), 1) AS `Avg departure delay`,\n       round(100 * countIf(DepDel15 = 1) / count(), 1) AS `% departing 15+ min late`\nFROM faa.ontime WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\nGROUP BY hour ORDER BY hour"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Avg departure delay"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% departing 15+ min late"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "hour",
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 11
    },
