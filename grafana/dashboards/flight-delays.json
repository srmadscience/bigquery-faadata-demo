      "options": {
        "xField": "Flight",
        "orientation": "horizontal",
        "showValue": "always",
        "barWidth": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-faa"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- Rank first, then find the main route of just the ten flights ranked.\nWITH top AS (\n    SELECT Reporting_Airline AS airline, Flight_Number_Reporting_Airline AS number, COUNT(*) AS n_flights,\n           ROUND(1000 * COUNTIF(Cancelled = 1 AND CancellationCode = 'A') / COUNT(*), 1) AS cxl,\n           ROUND(SAFE_DIVIDE(SUM(CarrierDelay), COUNTIF(Cancelled = 0)), 1) AS carrier_delay\n    FROM faa.ontime WHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\n    GROUP BY airline, number HAVING COUNTIF(Cancelled = 0) >= ${min_flights}\n    ORDER BY cxl DESC, carrier_delay DESC\n    LIMIT 10\n)\nSELECT CONCAT(airline, ' ', CAST(number AS STRING), ' (',\n              APPROX_TOP_COUNT(CONCAT(Origin, '–', Dest), 1)[OFFSET(0)].value, ')') AS Flight,\n       ANY_VALUE(cxl) AS `Carrier_cxl_1k_flights`, ANY_VALUE(carrier_delay) AS delay,\n       -- as text, so they appear in the tooltip without being drawn as bars\n       CAST(COUNT(DISTINCT CONCAT(Origin, Dest)) AS STRING) AS Routes,\n       CAST(ANY_VALUE(n_flights) AS STRING) AS Flights, CAST(ANY_VALUE(carrier_delay) AS STRING) AS `Carrier_delay_min_flt`\nFROM faa.ontime INNER JOIN top ON Reporting_Airline = airline AND Flight_Number_Reporting_Airline = number\nWHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\nGROUP BY airline, number\nORDER BY `Carrier_cxl_1k_flights` DESC, delay DESC"
        }
      ],
      "id": 16,
