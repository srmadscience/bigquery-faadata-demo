          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT Origin AS Airport, any(OriginCityName) AS City, count() AS Departures,\n       round(100 * countIf(DepDel15 = 1) / countIf(Cancelled = 0), 1) AS `Late departures %`,\n       round(avg(DepDelay), 1) AS `Avg dep delay`,\n       round(100 * avg(Cancelled), 2) AS `Cancelled %`\nFROM faa.ontime WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\nGROUP BY Airport HAVING Departures >= 1000\nORDER BY `Late departures %` DESC LIMIT 50"
        }
