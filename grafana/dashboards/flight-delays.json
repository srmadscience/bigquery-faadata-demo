    {
      "type": "stat",
      "title": "Avg delay if late",
      "description": "Mean arrival delay of flights that arrived 15+ minutes late.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      },
      "gridPos": {
        "x": 12,
