          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "SELECT Origin AS Airport, ANY_VALUE(OriginCityName) AS City, COUNT(*) AS Departures,\n       ROUND(100 * SAFE_DIVIDE(COUNTIF(DepDel15 = 1), COUNTIF(Cancelled = 0)), 1) AS `Late departures %`,\n       ROUND(AVG(DepDelay), 1) AS `Avg dep delay`,\n       ROUND(100 * AVG(Cancelled), 2) AS `Cancelled %`\nFROM faa.ontime WHERE FlightDate BETWEEN DATE($__timeFrom()) AND DATE($__timeTo()) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\nGROUP BY Airport HAVING Departures >= 1000\nORDER BY `Late departures %` DESC LIMIT 50"
        }
