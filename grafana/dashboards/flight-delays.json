      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-faa"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT concat(least(Origin, Dest), '–', greatest(Origin, Dest)) AS `City pair`,\n       round(1000 * countIf(Cancelled = 1 AND CancellationCode = 'A') / count(), 1) AS `Carrier cxl / 1k flights`,\n       round(sum(CarrierDelay) / countIf(Cancelled = 0), 1) AS delay,\n       -- as text, so they appear in the tooltip without being drawn as bars\n       -- city names from one flight of the pair, ordered like the airport codes\n       any((Origin, OriginCityName, DestCityName)) AS one_flight,\n       if(startsWith(`City pair`, one_flight.1), concat(one_flight.2, ' – ', one_flight.3), concat(one_flight.3, ' – ', one_flight.2)) AS Cities,\n       toString(count()) AS Flights, toString(delay) AS `Carrier delay min/flt`\nFROM faa.ontime WHERE $__dateFilter(FlightDate) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\nGROUP BY `City pair` HAVING countIf(Cancelled = 0) >= ${min_flights}\nORDER BY `Carrier cxl / 1k flights` DESC, delay DESC\nLIMIT 10"
        }
      ],
      "id": 15
