    {
      "type": "barchart",
      "title": "Top 10 least reliable city pairs",
      "description": "Airport pairs, both directions together, with the most carrier cancellations (code A) per 1,000 flights, among pairs with at least the minimum number of completed flights; ties go to the pair with more carrier delay per flight. The Origin airport filter applies to where each flight left from.",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-faa"
      },
      "gridPos": {
        "x": 0,
